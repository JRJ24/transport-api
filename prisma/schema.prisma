// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  schemas  = ["AUTH", "CUSTOMER", "DRIVERS", "VEHICLES", "PRICES", "ORDERS", "TRACKING", "EVIDENCES", "INCIDENTS", "PAIDS", "NOTIFICATIONS", "ADMINISTRATION", "AUDIT", "INTEGRATIONS"]
}

enum ROLES {
  ADMIN
  OPERATOR
  DRIVER
  CUSTOMER

  @@schema("AUTH")
}

enum STATUS_ACCOUNT {
  ACTIVE
  INACTIVE
  BLOCKED

  @@schema("AUTH")
}

enum TYPE_CUSTOMER {
  INDIVIDUAL
  BUSINESS

  @@schema("CUSTOMER")
}

enum STATUS_DRIVER {
  AVAILABLE
  BUSY
  OFFLINE
  SUSPENDED
  VACATION

  @@schema("DRIVERS")
}

enum VERIFICATION_STATUS {
  PENDING
  APPROVED
  REJECTED

  @@schema("DRIVERS")
}

enum VERIFICATION_STATUS_DOCS {
  PENDING
  APPROVED
  REJECTED

  @@schema("VEHICLES")
}

enum STATUS_VEHICLE {
  ACTIVE
  MAINTENANCE
  INACTIVE
  SUSPENDED

  @@schema("VEHICLES")
}

enum DOCUMENT_TYPE {
  ID
  RNC
  PASSPORT

  @@schema("CUSTOMER")
}

enum DOCUMENT_TYPE_VEHICLE {
  REGISTRATION
  INSURANCE
  INSPECTION
  OTHER

  @@schema("VEHICLES")
}

enum SERVICE_TYPE {
  INMEDIATE
  SCHEDULED

  @@schema("ORDERS")
}

enum STATUS_ORDERS {
  DRAFT
  PENDING_QUOTE
  PENDING_CUSTOMER_CONFIRMATION
  PENDING_PAYMENT
  CONFIRMED
  ASSIGNING_DRIVER
  REQUESTED
  ASSIGNED
  ACCEPTED
  IN_PROGRESS
  DELIVERED
  CANCELLED
  FAILED

  @@schema("ORDERS")
}

enum QUOTE_SOURCE {
  MANUAL
  GOOGLE_MAPS

  @@schema("PRICES")
}

enum QUOTE_STATUS {
  DRAFT
  PROVISIONAL
  CALCULATED
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  REPLACED

  @@schema("PRICES")
}

enum PAYMENT_STATUS {
  PENDING
  PROCESSING
  AUTHORIZED
  PAID
  REFUNDED
  FAILED
  CANCELLED
  EXPIRED

  @@schema("PAIDS")
}

enum STOP_TYPE {
  PICKUP
  DROPOFF
  INTERMEDIATE

  @@schema("ORDERS")
}

enum ASSIGNMENT_STATUS {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  COMPLETED

  @@schema("ORDERS")
}

enum EVENT_TYPE {
  CREATED
  ASSIGNED
  ACCEPTED
  PICKED_UP
  IN_TRANSIT
  ARRIVED
  DELIVERED
  CANCELLED
  INCIDENT_REPORTED

  @@schema("INCIDENTS")
}

enum RESERVATIONS_STATUS {
  ACTIVE
  RESCHUDULED
  CANCELLED
  EXPIRED
  COMPLETED

  @@schema("ORDERS")
}

enum ORDER_CANCELLATION {
  CUSTOMER_CANCELLED
  DRIVER_CANCELLED
  ADMIN_CANCELLED
  SYSTEM_CANCELLED

  @@schema("ORDERS")
}

enum TRACKING_SESSIONS {
  ACTIVE
  ENDED
  INTERRUPTED

  @@schema("TRACKING")
}

enum PROOF_TYPE {
  PHOTO
  SIGNATURE
  QR
  CODE
  MIXED

  @@schema("EVIDENCES")
}

enum VALIDATION {
  PENDING
  VALIDATED
  REJECTED

  @@schema("EVIDENCES")
}

enum INCIDENT_TYPE {
  DELAY
  DAMAGE
  CUSTOMER_ABSENT
  WRONG_ADDRESS
  VEHICLE_PROBLEM
  OTHER

  @@schema("INCIDENTS")
}

enum INCIDENT_SEVERITY {
  LOW
  MEDIUM
  HIGH
  CRITICAL

  @@schema("INCIDENTS")
}

enum INCIDENT_STATUS {
  OPEN
  IN_REVIEW
  RESOLVED
  CLOSED

  @@schema("INCIDENTS")
}

enum PAYMENT_METHOD {
  CARD
  CASH
  TRANSFER
  WALLET

  @@schema("PAIDS")
}

enum STATUS_PAYMENTS {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUNDED
  CANCELLED

  @@schema("PAIDS")
}

enum PAYMENT_TRANSACTIONS_TYPE {
  AUTHORIZATION
  CAPTURE
  REFUND
  VOID
  CANCELLATION_FEE

  @@schema("PAIDS")
}

enum PAYMENTS_TRANSACTIONS_STATUS {
  PENDING
  SUCCESS
  FAILED

  @@schema("PAIDS")
}

enum PAYMENTS_REFUND_STATUS {
  PENDING
  SUCCESS
  FAILED

  @@schema("PAIDS")
}

enum NOTIFICATION_TYPE {
  ORDER_UPDATE
  PAYMENT
  INCIDENT
  PROMOTION
  SYSTEM

  @@schema("NOTIFICATIONS")
}

enum NOTIFICATION_STATUS {
  PENDING
  SENT
  PARTIAL
  FAILED
  SKIPPED

  @@schema("NOTIFICATIONS")
}

enum DEVICE_PLATFORM {
  ANDROID
  IOS
  WEB

  @@schema("NOTIFICATIONS")
}

enum SYSTEM_VALUE {
  STRING
  NUMBER
  BOOLEAN
  JSON

  @@schema("ADMINISTRATION")
}

model User {
  id           String         @id @default(uuid())
  fullName     String         @map("full_name")
  email        String         @unique
  phone        String         @unique
  passwordHash String         @map("password_hash")
  status       STATUS_ACCOUNT @default(ACTIVE)
  lastLoginAt  DateTime?      @map("last_login_at")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("update_at")

  userRoles         UserRole[]        @relation("USERS")
  sessions          UserSession[]     @relation("USER_SESSIONS")
  customerProfiles  CustomerProfile[] @relation("USERS_CUSTOMER")
  driverProfiles    DriverProfile[]   @relation("DRIVER_USER")
  orderAssignments  OrderAssignment[] @relation("assigned_user")
  deliveryProofs    DeliveryProof[]   @relation("USER_DELIVERY")
  attachments       Attachment[]      @relation("Attachments_user")
  incidents         Incident[]        @relation("USER_REPORTED")
  incidentsComments IncidentComment[] @relation("USER_INCIDENTS_COMMENTS")
  notifications     Notification[]    @relation("NOTIFICATIONS_USERS")
  deviceTokens      DeviceToken[]     @relation("DEVICE_TOKENS_USERS")
  auditLogs         AuditLog[]        @relation("AUDIT_USERS")
  systemParameters  SystemParameter[] @relation("UPDATED_USER")

  @@index([email])
  @@index([phone])
  @@map("users")
  @@schema("AUTH")
}

model Role {
  id          String     @id @default(uuid())
  code        ROLES      @unique
  name        String
  description String
  userRoles   UserRole[] @relation("ROLES")

  @@map("roles")
  @@schema("AUTH")
}

model UserRole {
  id        String   @id @default(uuid())
  userID    String   @map("user_id")
  roleID    String   @map("roles_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation("USERS", fields: [userID], references: [id])
  rol  Role @relation("ROLES", fields: [roleID], references: [id])

  @@map("user_roles")
  @@schema("AUTH")
}

model UserSession {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  refreshTokenHash String    @map("refresh_token_hash")
  deviceId         String?   @map("device_id")
  deviceName       String?   @map("device_name")
  platform         String?
  ipAddress        String?   @map("ip_address")
  userAgent        String?   @map("user_agent")
  lastActivityAt   DateTime  @default(now()) @map("last_activity_at")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user User @relation("USER_SESSIONS", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@index([deviceId])
  @@map("user_sessions")
  @@schema("AUTH")
}

model CustomerProfile {
  id             String        @id @default(uuid())
  userId         String        @map("user_id")
  customerType   TYPE_CUSTOMER @map("customer_type")
  documentType   DOCUMENT_TYPE @map("document_type")
  documentNumber String        @map("document_number")
  companyName    String?       @map("company_name")
  billingEmail   String?       @map("billing_email")
  createdAt      DateTime      @map("created_at")

  user              User              @relation("USERS_CUSTOMER", fields: [userId], references: [id])
  customerAddresses CustomerAddress[] @relation("CUSTOMER_PROFILE")
  priceQuotes       PriceQuote[]      @relation("CUSTOMER_PRICE")
  transportOrders   TransportOrder[]  @relation("CUSTOMER_TRANSPORT")
  payments          Payment[]         @relation("CUSTOMER_PAYMENTS")

  @@map("customer_profile")
  @@schema("CUSTOMER")
}

model CustomerAddress {
  id            String   @id @default(uuid())
  customerId    String   @map("customer_id")
  label         String
  addressesLine String   @map("addresses_line")
  city          String
  province      String
  countryCode   String?  @map("country_code")
  postalCode    String?  @map("postal_code")
  latitude      Decimal?
  longitude     Decimal?
  isDefault     Boolean  @map("is_default")
  createdAt     DateTime @map("created_at")

  customer CustomerProfile @relation("CUSTOMER_PROFILE", fields: [customerId], references: [id])

  @@map("customer_addresses")
  @@schema("CUSTOMER")
}

model DriverProfile {
  id                 String              @id @default(uuid())
  userId             String              @map("user_id")
  licenseNumber      String              @map("license_number")
  licenseExpiration  DateTime            @map("license_expiration")
  availabilityStatus STATUS_DRIVER       @map("availability_status")
  verificationStatus VERIFICATION_STATUS @map("verification_status")
  ratingAVG          Decimal             @map("rating_avg")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  user             User              @relation("DRIVER_USER", fields: [userId], references: [id])
  driverDocuments  DriverDocument[]  @relation("DRIVER_DOCUMENTS")
  orderAssignments OrderAssignment[] @relation("DRIVER_ORDER")
  driverLocations  DriverLocation[]  @relation("DRIVER_LOCATIONS")
  trackingSessions TrackingSession[] @relation("DRIVER_TRACKING")

  @@index([licenseNumber])
  @@map("driver_profiles")
  @@schema("DRIVERS")
}

model DriverDocument {
  id           String              @id @default(uuid())
  driverId     String              @map("driver_id")
  documentType String              @map("document_type")
  fileURL      String              @map("file_url")
  status       VERIFICATION_STATUS
  reviewNotes  String              @map("review_notes")
  uploadedAt   DateTime            @default(now())

  driver DriverProfile @relation("DRIVER_DOCUMENTS", fields: [driverId], references: [id])

  @@map("driver_documents")
  @@schema("DRIVERS")
}

model VehicleCategory {
  id               String           @id @default(uuid())
  code             String           @unique
  name             String
  description      String
  maxWeightKg      Decimal          @map("max_weight_kg")
  maxVolumenM3     Decimal          @map("max_volumen_m3")
  baseCapacityNote String           @map("base_capacity_note")
  isActive         Boolean          @map("is_active")
  vehicles         Vehicle[]        @relation("VEHICLE_CATEGORIES")
  priceQuotes      PriceQuote[]     @relation("VEHICLECATEGORY_PRICE")
  transportOrders  TransportOrder[] @relation("VEHICLECATEGORY_TRANSPORT")

  @@map("vehicle_categories")
  @@schema("VEHICLES")
}

model Vehicle {
  id          String         @id @default(uuid())
  driverId    String         @map("driver_id")
  categoryId  String         @map("category_id")
  plateNumber String         @unique @map("plate_number")
  brand       String
  model       String
  year        Int
  color       String
  urlImage    String?        @map("url_image")
  status      STATUS_VEHICLE @default(ACTIVE)
  createdAt   DateTime       @map("created_at")

  vehicleCategory   VehicleCategory   @relation("VEHICLE_CATEGORIES", fields: [categoryId], references: [id])
  vehiclesDocuments VehicleDocument[] @relation("VEHICLE_DOCUMENTS")
  orderAssignments  OrderAssignment[] @relation("VEHICLES_ORDER")

  @@map("vehicles")
  @@schema("VEHICLES")
}

model VehicleDocument {
  id             String                   @id @default(uuid())
  vehicleId      String                   @map("vehicle_id")
  documentType   DOCUMENT_TYPE_VEHICLE
  fileUrl        String                   @map("file_url")
  expirationDate DateTime                 @map("expiration_date")
  status         VERIFICATION_STATUS_DOCS @default(PENDING)
  uploadedAt     DateTime                 @default(now())

  vehicleCategory Vehicle @relation("VEHICLE_DOCUMENTS", fields: [vehicleId], references: [id])

  @@map("vehicles_documents")
  @@schema("VEHICLES")
}

model RateCard {
  id          String    @id @default(uuid())
  name        String
  description String
  validForm   DateTime  @map("valid_form")
  validTo     DateTime? @map("valid_to")
  isActive    Boolean   @map("is_active")
  createdAt   DateTime  @default(now())

  rateRules RateRule[] @relation("RATE_CARDS")

  @@map("rate_cards")
  @@schema("PRICES")
}

model RateRule {
  id                    String   @id @default(uuid())
  rateCardId            String   @map("rate_card_id")
  vehicleCategoryId     String   @map("vehicule_category_id")
  baseFare              Decimal  @map("base_fare")
  pricePerKM            Decimal  @map("price_per_km")
  pricePerMinute        Decimal  @map("price_per_minute")
  minimumFare           Decimal  @map("minimum_fare")
  helperFee             Decimal  @map("helper_fee")
  nightFee              Decimal  @map("night_fee")
  waitingPricePerMinute Decimal  @map("waiting_price_per_minute")
  cancellationFee       Decimal  @map("cancellation_fee")
  createdAt             DateTime @map("created_at")

  rateCard RateCard @relation("RATE_CARDS", fields: [rateCardId], references: [id])

  @@map("rate_rule")
  @@schema("PRICES")
}

model PriceQuote {
  id                     String       @id @default(uuid())
  customerId             String       @map("customer_id")
  orderId                String?      @map("order_id")
  vehicleCategoryId      String       @map("vehicle_category_id")
  originAddress          String       @map("origin_address")
  destinationAddress     String       @map("destination_address")
  distanceKm             Decimal      @map("distance_km")
  estimatedDurationMin   Int          @map("estimated_duration_min")
  baseAmount             Decimal      @map("base_amount")
  extrasAmount           Decimal      @map("extras_amount")
  demandAmount           Decimal      @map("demand_amount")
  weatherAmount          Decimal      @map("weather_amount")
  taxAmount              Decimal      @map("tax_amount")
  totalAmount            Decimal      @map("total_amount")
  quoteSource            QUOTE_SOURCE @default(MANUAL) @map("quote_source")
  quoteStatus            QUOTE_STATUS @default(PROVISIONAL) @map("quote_status")
  breakdown              Json?
  manualAdjustmentAmount Decimal      @default(0) @map("manual_adjustment_amount")
  adjustmentReason       String?      @map("adjustment_reason")
  adjustedBy             String?      @map("adjusted_by")
  expiresAt              DateTime     @map("expires_at")
  createdAt              DateTime     @default(now()) @map("created_at")

  customer        CustomerProfile  @relation("CUSTOMER_PRICE", fields: [customerId], references: [id])
  order           TransportOrder?  @relation("ORDER_PRICE_QUOTES", fields: [orderId], references: [id])
  vehicleCategory VehicleCategory  @relation("VEHICLECATEGORY_PRICE", fields: [vehicleCategoryId], references: [id])
  transportOrders TransportOrder[] @relation("PRICE_TRANSPORT")

  @@index([orderId])
  @@index([quoteStatus])
  @@map("price_quotes")
  @@schema("PRICES")
}

model TransportOrder {
  id                   String         @id @default(uuid())
  orderCode            String         @unique @map("order_code")
  customerId           String         @map("customer_id")
  quoteId              String?        @map("quotes_id")
  vehicleCategoryId    String         @map("vehicle_category_id")
  serviceType          SERVICE_TYPE
  status               STATUS_ORDERS
  scheduleAt           DateTime?      @map("schedule_at")
  pickupAt             DateTime?      @map("pickup_at")
  deliveredAt          DateTime?      @map("delivered_at")
  distanceKm           Decimal?       @map("distance_km")
  estimatedDurationMin Int?           @map("estimated_duration_min")
  totalAmount          Decimal?       @map("total_amout")
  paymentStatus        PAYMENT_STATUS
  notes                String
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("update_at")

  customer           CustomerProfile     @relation("CUSTOMER_TRANSPORT", fields: [customerId], references: [id])
  quote              PriceQuote?         @relation("PRICE_TRANSPORT", fields: [quoteId], references: [id])
  priceQuotes        PriceQuote[]        @relation("ORDER_PRICE_QUOTES")
  vehicleCategory    VehicleCategory     @relation("VEHICLECATEGORY_TRANSPORT", fields: [vehicleCategoryId], references: [id])
  orderItems         OrderItem[]         @relation("ORDERITEMS_TRANSPORTORDER")
  orderAssignments   OrderAssignment[]   @relation("ORDERASSIGNMENTS_TRANSPORTORDER")
  orderStops         OrderStop[]         @relation("ORDERSTOPS_TRANSPORTORDER")
  orderEvents        OrderEvent[]        @relation("ORDEREVENTS_TRANSPORTORDER")
  reservations       Reservation[]       @relation("ORDER_RESERVATION")
  orderCancellations OrderCancellation[] @relation("ORDER_CANCELLATION")
  driverLocations    DriverLocation[]    @relation("ORDER_DRIVERLOCATIONS")
  trackingSessions   TrackingSession[]   @relation("ORDER_TRACKING")
  deliveryProofs     DeliveryProof[]     @relation("ORDER_DELIVERY")
  incidents          Incident[]          @relation("ORDER_INCIDENTS")
  payments           Payment[]           @relation("ORDERS_PAYMENTS")
  refunds            Refund[]            @relation("REFUNDS_ORDERS")

  @@index([orderCode])
  @@index([customerId])
  @@index([quoteId])
  @@index([vehicleCategoryId])
  @@map("TransportOrders")
  @@schema("ORDERS")
}

model OrderStop {
  id           String    @id @default(uuid())
  orderId      String    @map("order_id")
  stopType     STOP_TYPE
  sequence     Int
  contactName  String    @map("contact_name")
  contactPhone String    @map("contact_phone")
  addressLine  String    @map("address_line")
  city         String
  province     String
  latitude     Decimal?  @db.Decimal(9, 6)
  longitude    Decimal?  @db.Decimal(9, 6)
  instructions String?
  arrivedAt    DateTime? @map("arrived_at")
  completedAt  DateTime? @map("completed_at")

  order TransportOrder @relation("ORDERSTOPS_TRANSPORTORDER", fields: [orderId], references: [id])

  @@index([orderId])
  @@index([contactName])
  @@index([contactPhone])
  @@index([addressLine])
  @@map("order_stops")
  @@schema("ORDERS")
}

model OrderItem {
  id            String   @id @default(uuid())
  orderId       String   @map("order_id")
  description   String
  quantity      Int
  weightKg      Decimal  @map("weight_kg")
  volumeM3      Decimal? @map("volume_m3")
  declaredValue Decimal? @map("declared_value")
  fragile       Boolean
  requireHelper Boolean  @map("require_helper")
  createdAt     DateTime @default(now()) @map("created_at")

  order TransportOrder @relation("ORDERITEMS_TRANSPORTORDER", fields: [orderId], references: [id])

  @@index([orderId])
  @@map("order_items")
  @@schema("ORDERS")
}

model OrderAssignment {
  id               String            @id @default(uuid())
  orderId          String            @map("order_id")
  driverId         String            @map("driver_id")
  vehicleId        String            @map("vehicle_id")
  assignedBy       String?           @map("assigned_by")
  assignmentStatus ASSIGNMENT_STATUS @map("assignment_status")
  assignedAt       DateTime          @default(now()) @map("assigned_at")
  acceptedAt       DateTime?         @map("accepted_at")
  rejectedAt       DateTime?         @map("rejected_at")

  order   TransportOrder @relation("ORDERASSIGNMENTS_TRANSPORTORDER", fields: [orderId], references: [id])
  driver  DriverProfile  @relation("DRIVER_ORDER", fields: [driverId], references: [id])
  vehicle Vehicle        @relation("VEHICLES_ORDER", fields: [vehicleId], references: [id])
  user    User?          @relation("assigned_user", fields: [assignedBy], references: [id])

  @@index([assignedBy])
  @@index([orderId])
  @@index([driverId])
  @@index([vehicleId])
  @@map("order_assignments")
  @@schema("ORDERS")
}

model OrderEvent {
  id          String     @id @default(uuid())
  orderId     String     @map("order_id")
  eventType   EVENT_TYPE @map("event_type")
  actorUserId String     @map("actor_user_id")
  description String
  metadata    Json
  latitude    Decimal?   @db.Decimal(9, 6)
  longitude   Decimal?   @db.Decimal(9, 6)
  createdAt   DateTime   @default(now()) @map("created_at")

  order TransportOrder @relation("ORDEREVENTS_TRANSPORTORDER", fields: [orderId], references: [id])

  @@index([orderId, createdAt])
  @@map("order_events")
  @@schema("ORDERS")
}

model Reservation {
  id                   String              @id @default(uuid())
  orderId              String              @map("order_id")
  reservedFor          DateTime            @map("reserved_for")
  reservationStatus    RESERVATIONS_STATUS @map("reservation_status")
  rescheduleCount      Int                 @map("reschedule_count")
  cancellationDeadline DateTime            @map("cancellation_deadline")
  createdAt            DateTime            @map("created_at")

  order TransportOrder @relation("ORDER_RESERVATION", fields: [orderId], references: [id])

  @@map("reservation")
  @@schema("ORDERS")
}

model OrderCancellation {
  id                 String             @id @default(uuid())
  orderId            String             @map("order_id")
  cancelledBy        String             @map("cancelled_by")
  cancellationReason String             @map("cancellation_reason")
  cancellationType   ORDER_CANCELLATION @map("cancellation_type")
  feeApplied         Boolean            @map("fee_applied")
  feeAmount          Decimal            @map("fee_amount")
  refundAmount       Decimal            @map("refund_amount")
  cancelledAt        DateTime           @default(now()) @map("cancelled_at")

  order TransportOrder @relation("ORDER_CANCELLATION", fields: [orderId], references: [id])

  @@map("order_cancellations")
  @@schema("ORDERS")
}

model DriverLocation {
  id           String   @id @default(uuid())
  driverId     String   @map("driver_id")
  orderId      String   @map("order_id")
  sessionId    String?  @map("session_id")
  vehicleId    String?  @map("vehicle_id")
  latitude     Decimal  @db.Decimal(9, 6)
  longitude    Decimal  @db.Decimal(9, 6)
  accuracy     Decimal? @db.Decimal(8, 2)
  altitude     Decimal? @db.Decimal(8, 2)
  speed        Decimal? @db.Decimal(8, 2)
  heading      Decimal? @db.Decimal(6, 2)
  batteryLevel Int?     @map("battery_level")
  sequence     Int?
  isMocked     Boolean  @default(false) @map("is_mocked")
  clientId     String?  @map("client_id")
  recordedAt   DateTime @map("recorded_at")
  receivedAt   DateTime @map("received_at")

  order   TransportOrder   @relation("ORDER_DRIVERLOCATIONS", fields: [orderId], references: [id])
  driver  DriverProfile    @relation("DRIVER_LOCATIONS", fields: [driverId], references: [id])
  session TrackingSession? @relation("SESSION_LOCATIONS", fields: [sessionId], references: [id])

  @@unique([sessionId, clientId], name: "session_client_idempotency")
  @@index([sessionId, recordedAt])
  @@index([orderId, recordedAt])
  @@index([driverId, recordedAt])
  @@index([vehicleId, recordedAt])
  @@map("driver_locations")
  @@schema("DRIVERS")
}

model TrackingSession {
  id             String            @id @default(uuid())
  orderId        String            @map("order_id")
  driverId       String            @map("driver_id")
  startedAt      DateTime          @map("started_at")
  endedAt        DateTime?         @map("ended_at")
  status         TRACKING_SESSIONS
  lastLocationAt DateTime?         @map("last_location_at")

  order     TransportOrder   @relation("ORDER_TRACKING", fields: [orderId], references: [id])
  driver    DriverProfile    @relation("DRIVER_TRACKING", fields: [driverId], references: [id])
  locations DriverLocation[] @relation("SESSION_LOCATIONS")

  @@index([orderId, status])
  @@index([driverId, status])
  @@map("tracking_sessions")
  @@schema("TRACKING")
}

model DeliveryProof {
  id                String     @id @default(uuid())
  orderId           String     @map("order_id")
  proofType         PROOF_TYPE @map("proof_type")
  recipientName     String     @map("recipient_name")
  recipientDocument String     @map("recipient_document")
  notes             String?
  latitude          Decimal
  longitude         Decimal
  capturedBy        String     @map("captured_by")
  capturedAt        DateTime   @default(now()) @map("captured_at")
  validatedAt       DateTime   @map("validate_at")
  validationStatus  VALIDATION @default(PENDING) @map("validation_status")

  order      TransportOrder @relation("ORDER_DELIVERY", fields: [orderId], references: [id])
  driver     User           @relation("USER_DELIVERY", fields: [capturedBy], references: [id])
  signatures Signature[]    @relation("SIGNATURE_DELIVERYPROOFS")

  @@index([recipientName])
  @@map("delivery_proofs")
  @@schema("EVIDENCES")
}

model Signature {
  id           String   @id @default(uuid())
  proofId      String   @map("proof_id")
  signatureUrl String   @map("signature_url")
  signerName   String   @map("signer_name")
  signedAt     DateTime @default(now()) @map("signed_at")

  proof DeliveryProof @relation("SIGNATURE_DELIVERYPROOFS", fields: [proofId], references: [id])

  @@map("signatures")
  @@schema("EVIDENCES")
}

model Attachment {
  id         String   @id @default(uuid())
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  fileName   String   @map("file_name")
  fileUrl    String   @map("file_url")
  fileSize   Int      @map("file_size")
  mimeType   String   @map("mime_type")
  uploadedBy String   @map("uploaded_by")
  createdAt  DateTime @map("created_at")

  user User @relation("Attachments_user", fields: [uploadedBy], references: [id])

  @@index([entityId])
  @@map("attachments")
  @@schema("EVIDENCES")
}

model Incident {
  id           String            @id @default(uuid())
  orderId      String            @map("order_id")
  reportedBy   String            @map("reported_by")
  incidentType INCIDENT_TYPE     @map("incident_type")
  severity     INCIDENT_SEVERITY
  title        String
  description  String
  status       INCIDENT_STATUS
  latitude     Decimal
  longitude    Decimal
  reportedAt   DateTime          @default(now()) @map("reported_at")
  resolvedAt   DateTime?         @map("resolved_at")

  order             TransportOrder    @relation("ORDER_INCIDENTS", fields: [orderId], references: [id])
  user              User              @relation("USER_REPORTED", fields: [reportedBy], references: [id])
  incidentsComments IncidentComment[] @relation("INCIDENTS_COMMENTS")

  @@index([orderId])
  @@index([reportedBy])
  @@index([title])
  @@map("incidents")
  @@schema("INCIDENTS")
}

model IncidentComment {
  id         String   @id @default(uuid())
  incidentId String   @map("incident_id")
  userId     String   @map("user_id")
  comment    String
  createdAt  DateTime @default(now()) @map("created_at")

  user     User     @relation("USER_INCIDENTS_COMMENTS", fields: [userId], references: [id])
  incident Incident @relation("INCIDENTS_COMMENTS", fields: [incidentId], references: [id])

  @@index([userId])
  @@map("incidents_comments")
  @@schema("INCIDENTS")
}

model Payment {
  id                       String         @id @default(uuid())
  orderId                  String         @map("order_id")
  customerId               String         @map("customer_id")
  amount                   Decimal
  currency                 String
  paymentMethod            PAYMENT_METHOD @map("payment_method")
  paymentProvider          String?        @map("payment_provider")
  status                   PAYMENT_STATUS
  providerReference        String?
  transactionId            String?        @map("transaction_id")
  providerSessionId        String?        @unique @map("provider_session_id")
  providerSessionKey       String?        @map("provider_session_key")
  responseCode             String?        @map("response_code")
  remoteResponseCode       String?        @map("remote_response_code")
  authorizationCode        String?        @map("authorization_code")
  retrievalReferenceNumber String?        @map("retrieval_reference_number")
  transactionToken         String?        @map("transaction_token")
  maskedCardNumber         String?        @map("masked_card_number")
  sessionCreatedAt         DateTime?      @map("session_created_at")
  verifiedAt               DateTime?      @map("verified_at")
  expiresAt                DateTime?      @map("expires_at")
  paidAt                   DateTime?      @map("paid_at")
  createdAt                DateTime       @default(now()) @map("created_at")
  updatedAt                DateTime       @updatedAt @map("updated_at")

  order                TransportOrder       @relation("ORDERS_PAYMENTS", fields: [orderId], references: [id])
  customer             CustomerProfile      @relation("CUSTOMER_PAYMENTS", fields: [customerId], references: [id])
  paymentsTransactions PaymentTransaction[] @relation("PAYMENTS_TRANSACTIONS")
  refunds              Refund[]             @relation("PAYMENT_REFUNDS")

  @@unique([paymentProvider, transactionId])
  @@index([orderId])
  @@index([status, createdAt])
  @@map("payments")
  @@schema("PAIDS")
}

model PaymentTransaction {
  id               String                       @id @default(uuid())
  paymentId        String                       @map("payment_id")
  transactionType  PAYMENT_TRANSACTIONS_TYPE    @map("transaction_type")
  amount           Decimal
  status           PAYMENTS_TRANSACTIONS_STATUS
  providerResponse Json                         @map("provider_response")
  createdAt        DateTime                     @default(now()) @map("created_at")

  payment Payment @relation("PAYMENTS_TRANSACTIONS", fields: [paymentId], references: [id])

  @@map("payments_transactions")
  @@schema("PAIDS")
}

model Refund {
  id                String                 @id @default(uuid())
  paymentId         String                 @map("payment_id")
  orderId           String                 @map("order_id")
  amount            Decimal
  reason            String
  status            PAYMENTS_REFUND_STATUS
  providerReference String?                @map("provider_response")
  createdAt         DateTime               @map("created_at")

  order   TransportOrder @relation("REFUNDS_ORDERS", fields: [orderId], references: [id])
  payment Payment        @relation("PAYMENT_REFUNDS", fields: [paymentId], references: [id])

  @@index([orderId])
  @@index([paymentId])
  @@map("refunds")
  @@schema("PAIDS")
}

model Notification {
  id               String              @id @default(uuid())
  userId           String              @map("user_id")
  title            String
  message          String
  notificationType NOTIFICATION_TYPE   @map("notification_type")
  data             Json
  status           NOTIFICATION_STATUS @default(PENDING)
  sentAt           DateTime?           @map("sent_at")
  failureReason    String?             @map("failure_reason")
  readAt           DateTime?           @map("read_at")
  createdAt        DateTime            @default(now()) @map("created_at")

  user User @relation("NOTIFICATIONS_USERS", fields: [userId], references: [id])

  @@index([userId])
  @@index([title])
  @@index([userId, readAt, createdAt])
  @@index([status, createdAt])
  @@map("notifications")
  @@schema("NOTIFICATIONS")
}

model DeviceToken {
  id             String          @id @default(uuid())
  userId         String          @map("user_id")
  token          String          @unique
  platform       DEVICE_PLATFORM
  installationId String          @map("installation_id")
  deviceName     String?         @map("device_name")
  appVersion     String?         @map("app_version")
  locale         String?
  isActive       Boolean         @default(true) @map("is_active")
  failureCount   Int             @default(0) @map("failure_count")
  lastUsedAt     DateTime        @default(now()) @map("last_used_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  user User @relation("DEVICE_TOKENS_USERS", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, installationId], name: "user_installation")
  @@index([userId, isActive])
  @@map("device_tokens")
  @@schema("NOTIFICATIONS")
}

model SystemParameter {
  id          String       @id @default(uuid())
  key         String       @unique
  value       String
  valueType   SYSTEM_VALUE @map("value_type")
  description String
  updatedBy   String       @map("updated_by")
  updatedAt   DateTime     @updatedAt

  user User @relation("UPDATED_USER", fields: [updatedBy], references: [id])

  @@index([key])
  @@map("system_parameters")
  @@schema("ADMINISTRATION")
}

model Catalog {
  id        String  @id @default(uuid())
  groupKey  String  @map("group_key")
  code      String
  label     String
  sortOrder Int     @map("sort_order")
  isActive  Boolean @map("is_active")

  @@index([code])
  @@map("catalogs")
  @@schema("ADMINISTRATION")
}

model Province {
  id             String         @id @default(uuid())
  code           String         @unique
  name           String
  sortOrder      Int            @map("sort_order")
  isActive       Boolean        @default(true) @map("is_active")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  municipalities Municipality[] @relation("PROVINCE_MUNICIPALITIES")

  @@index([name])
  @@map("provinces")
  @@schema("ADMINISTRATION")
}

model Municipality {
  id         String   @id @default(uuid())
  provinceId String   @map("province_id")
  code       String
  name       String
  sortOrder  Int      @map("sort_order")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  province Province @relation("PROVINCE_MUNICIPALITIES", fields: [provinceId], references: [id])

  @@unique([provinceId, code])
  @@index([provinceId])
  @@index([name])
  @@map("municipalities")
  @@schema("ADMINISTRATION")
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?  @map("actor_user_id")
  action      String
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  oldValues   Json?    @map("old_values")
  newValues   Json?    @map("new_values")
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @map("created_at")

  user User? @relation("AUDIT_USERS", fields: [actorUserId], references: [id])

  @@index([entityId])
  @@index([ipAddress])
  @@map("audit_logs")
  @@schema("AUDIT")
}

model WebhookEvent {
  id              String   @id @default(uuid())
  eventType       String   @map("event_type")
  externalEventId String   @map("external_event_id")
  payload         Json
  processed       Boolean
  processedAt     DateTime @map("processed_at")
  createdAt       DateTime @map("created_at")

  @@map("webhook_events")
  @@schema("INTEGRATIONS")
}

model ExternalApiLog {
  id              String   @id @default(uuid())
  provider        String
  endpoint        String
  requestPayload  Json?    @map("request_payload")
  responsePayload Json?    @map("response_payload")
  statusCode      Int?     @map("status_code")
  success         Boolean
  createdAt       DateTime @map("created_at")

  @@index([requestPayload])
  @@index([responsePayload])
  @@map("external_api_logs")
  @@schema("INTEGRATIONS")
}
