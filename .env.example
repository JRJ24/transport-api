# ── App ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3001
SWAGGER_ENABLED=true
LOG_LEVEL=info

# ── Database ───────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5436/ruta_rd"

# ── Auth / JWT ─────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-to-a-random-string-of-at-least-32-chars
JWT_REFRESH_SECRET=change-me-to-a-different-random-string-of-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_MOBILE=30d
JWT_REFRESH_TTL_WEB=7d
BCRYPT_SALT_ROUNDS=12

# ── Rate limiting ──────────────────────────────────────────────────────────
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# ── Seed (development only) ────────────────────────────────────────────────
ADMIN_EMAIL=admin@rutard.local
ADMIN_PASSWORD=Admin123!ChangeMe
ADMIN_PHONE=+18090000000

# ── Integrations (Phase 3, optional) ───────────────────────────────────────
# GOOGLE_MAPS_API_KEY=
# PAYMENT_PROVIDER=stripe
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# AZUL_MERCHANT_ID=
# CARDNET_MERCHANT_ID=
# STORAGE_DRIVER=s3
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ENDPOINT=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=no-reply@rutard.local
# FCM_PROJECT_ID=
