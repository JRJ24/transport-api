# ── App ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3001
SWAGGER_ENABLED=true
LOG_LEVEL=info

# ── Database ───────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5436/ruta_rd"

# ── Auth / JWT ─────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-to-a-random-string-of-at-least-32-chars
JWT_REFRESH_SECRET=change-me-to-a-different-random-string-of-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_MOBILE=30d
JWT_REFRESH_TTL_WEB=7d
BCRYPT_SALT_ROUNDS=12

# ── Rate limiting ──────────────────────────────────────────────────────────
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# ── Seed (development only) ────────────────────────────────────────────────
ADMIN_EMAIL=admin@rutard.local
ADMIN_PASSWORD=Admin123!ChangeMe
ADMIN_PHONE=+18090000000

# ── Google Maps Platform (server-side ONLY — never ship to the mobile app) ──
# Restrict this key by IP (server) + to the Routes API in Google Cloud.
GOOGLE_MAPS_SERVER_API_KEY=
GOOGLE_ROUTES_API_BASE_URL=https://routes.googleapis.com
GOOGLE_ROUTES_TIMEOUT_MS=10000
GOOGLE_MAPS_TIMEOUT_MS=10000
GOOGLE_PLACES_API_BASE_URL=https://places.googleapis.com/v1
GOOGLE_GEOCODING_API_BASE_URL=https://maps.googleapis.com/maps/api/geocode/json
GOOGLE_ADDRESS_VALIDATION_API_BASE_URL=https://addressvalidation.googleapis.com/v1:validateAddress
GOOGLE_ROADS_API_BASE_URL=https://roads.googleapis.com/v1
GOOGLE_ROUTE_OPTIMIZATION_API_BASE_URL=https://routeoptimization.googleapis.com
GOOGLE_ROUTE_OPTIMIZATION_PROJECT_ID=
# Legacy alias (still read as a fallback):
# GOOGLE_MAPS_API_KEY=

# ── GPS tracking tuning ─────────────────────────────────────────────────────
GPS_MAX_ACCURACY_M=100
GPS_MAX_SPEED_MPS=70
TRACKING_MAX_BATCH=500

# ── Firebase Cloud Messaging (FCM HTTP v1, server-side ONLY) ────────────────
# Provide either the three inline fields OR GOOGLE_APPLICATION_CREDENTIALS.
# NEVER commit a real service account. Escape the private key newlines as \n.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# ── Redis / BullMQ ─────────────────────────────────────────────────────────
# Push delivery queue, driver presence (H3 cells), dispatch offers and demand
# windows. Without REDIS_URL push is sent inline and H3 matching is disabled.
# REDIS_URL es lo unico que enciende Redis: REDIS_HOST/REDIS_PORT solos no
# bastan. Sin REDIS_URL cada ping de presencia del conductor se rechaza con
# REDIS_DISABLED, el matching H3 no encuentra candidatos y las ofertas
# automaticas quedan apagadas (la app del conductor no muestra ningun aviso).
# Para probar presencia/H3/ofertas en dev local levantar Redis/Valkey
# (docker run -p 6379:6379 redis:7) y descomentar la linea de abajo. Queda
# comentada porque con REDIS_URL definido y Redis caido la cola de push espera
# la conexion sin limite y las peticiones que notifican (p. ej. asignar una
# orden) se quedan colgadas, y el setup del README copia este archivo sin Redis.
# REDIS_URL=redis://127.0.0.1:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# NOTIFICATIONS_QUEUE_DRIVER=bullmq   # or "inline" (default without REDIS_URL)

# ── Driver matching (H3 presence + road ETA ranking) ──────────────────────
# MATCHING_H3_RES=8               # presence cell resolution (8 = ~460 m edge)
# MATCHING_MAX_RINGS=3            # how far the search grows around the pickup
# MATCHING_MIN_CANDIDATES=5
# MATCHING_MAX_MATRIX=25          # origins per Route Matrix call (billed)
# PRESENCE_TTL_SEC=60             # a position older than this is stale
# PRESENCE_MIN_INTERVAL_MS=3000
# MATCHING_AUTO_OFFER=off         # on: offer paid orders to the best driver
# OFFER_TTL_SEC=30                # seconds a driver has to answer an offer
# MATCHING_MANUAL_ENFORCE=off     # on: TMS may only assign eligible candidates
# MATCHING_SWEEP_MS=10000
# MATCHING_RETRY_COOLDOWN_SEC=60
# MATCHING_SCORE_VERSION=v1

# ── Demand multiplier (supply/demand per H3 area) ──────────────────────────
# DEMAND_PRICING=off              # off | shadow (record only) | on (charge)
# DEMAND_H3_RES=7
# DEMAND_WINDOW_SEC=600
# DEMAND_MIN_OBSERVATIONS=3
# DEMAND_MAX_MULTIPLIER=1.35

# ── Evidence uploads / DigitalOcean Spaces ─────────────────────────────────
STORAGE_DRIVER=spaces
SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
SPACES_REGION=nyc3
SPACES_BUCKET=
# Optional CDN/custom domain, no trailing slash. If empty, API builds the Space URL.
SPACES_PUBLIC_URL=
SPACES_UPLOAD_PREFIX=evidences
SPACES_ACCESS_KEY_ID=
SPACES_SECRET_ACCESS_KEY=
MAX_UPLOAD_MB=50
# Local fallback if SPACES_BUCKET is empty:
# LOCAL_UPLOAD_DIR=./uploads
# LOCAL_UPLOAD_PUBLIC_URL=http://localhost:3000/uploads

