# ── App ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3001
SWAGGER_ENABLED=true
LOG_LEVEL=info

# ── Database ───────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5436/ruta_rd"

# ── Auth / JWT ─────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-to-a-random-string-of-at-least-32-chars
JWT_REFRESH_SECRET=change-me-to-a-different-random-string-of-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_MOBILE=30d
JWT_REFRESH_TTL_WEB=7d
BCRYPT_SALT_ROUNDS=12

# ── Rate limiting ──────────────────────────────────────────────────────────
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# ── Seed (development only) ────────────────────────────────────────────────
ADMIN_EMAIL=admin@rutard.local
ADMIN_PASSWORD=Admin123!ChangeMe
ADMIN_PHONE=+18090000000

# ── Google Maps Platform (server-side ONLY — never ship to the mobile app) ──
# Restrict this key by IP (server) + to the Routes API in Google Cloud.
GOOGLE_MAPS_SERVER_API_KEY=
GOOGLE_ROUTES_API_BASE_URL=https://routes.googleapis.com
GOOGLE_ROUTES_TIMEOUT_MS=10000
# Legacy alias (still read as a fallback):
# GOOGLE_MAPS_API_KEY=

# ── GPS tracking tuning ─────────────────────────────────────────────────────
GPS_MAX_ACCURACY_M=100
GPS_MAX_SPEED_MPS=70
TRACKING_MAX_BATCH=500

# ── Firebase Cloud Messaging (FCM HTTP v1, server-side ONLY) ────────────────
# Provide either the three inline fields OR GOOGLE_APPLICATION_CREDENTIALS.
# NEVER commit a real service account. Escape the private key newlines as \n.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# ── Redis / BullMQ (push delivery queue). Leave REDIS_URL empty for inline. ─
# REDIS_URL=redis://127.0.0.1:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# NOTIFICATIONS_QUEUE_DRIVER=bullmq   # or "inline" (default without REDIS_URL)

# ── Integrations ───────────────────────────────────────────────────────────
# PAYMENT_PROVIDER=cardnet
# PAYMENT_CALLBACK_BASE_URL=http://localhost:3000/api/v1
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# CARDNET_ENVIRONMENT=sandbox
# CARDNET_MERCHANT_ID=
# CARDNET_TERMINAL_ID=
# CARDNET_API_URL=
# CARDNET_API_KEY=
# CARDNET_SECRET_KEY=
# CARDNET_WEBHOOK_SECRET=
# AZUL_ENVIRONMENT=sandbox
# AZUL_MERCHANT_ID=
# AZUL_API_URL=
# AZUL_API_KEY=
# AZUL_SECRET_KEY=
# AZUL_WEBHOOK_SECRET=
# STORAGE_DRIVER=s3
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ENDPOINT=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=no-reply@rutard.local
# FCM_PROJECT_ID=
